<Window x:Class="Riga.ExportarTablas.Ui.Ventana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Riga.ExportarTablas.Ui"
        Title="Exportar tablas" Height="760" Width="1240" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" Background="#F0F0F0">

    <Window.Resources>
        <local:ColorClase x:Key="colorClase"/>

        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,3,3,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Padding" Value="12,5,12,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="Leyenda" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8"
                   Text="Exportar tablas de planificacion a Excel"
                   FontSize="15" FontWeight="SemiBold" Foreground="#333"/>

        <!-- ============ tablas ============ -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Seleccione tablas de planificacion">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <CheckBox DockPanel.Dock="Left" x:Name="chTodas" Margin="2,0,8,0"
                              Click="Todas_Click" ToolTip="Marcar o desmarcar todo lo que se ve."/>
                    <TextBox x:Name="txBuscarTabla" TextChanged="BuscarTabla_Cambio"
                             ToolTip="Filtra por nombre de tabla."/>
                </DockPanel>

                <ListBox Grid.Row="1" x:Name="listaTablas" BorderThickness="1" BorderBrush="#DDD"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Marcada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,1,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detalle}" Foreground="#888" FontSize="11"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- ============ parametros ============ -->
        <GroupBox Grid.Row="1" Grid.Column="2" Header="Parametros">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" x:Name="txBuscarParam" Margin="0,0,0,6"
                         TextChanged="BuscarParam_Cambio" ToolTip="Filtra por nombre de parametro."/>

                <ListBox Grid.Row="1" x:Name="listaParams" BorderThickness="1" BorderBrush="#DDD"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{Binding Clase, Converter={StaticResource colorClase}}"/>
                            <Setter Property="Padding" Value="2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Content="{Binding Nombre}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Style="{StaticResource Leyenda}" Background="#EAF5E1">
                        <TextBlock Text="Instancia"/>
                    </Border>
                    <Border Style="{StaticResource Leyenda}" Background="#FBF3D5">
                        <TextBlock Text="Tipo"/>
                    </Border>
                    <Border Style="{StaticResource Leyenda}" Background="#FADBDB">
                        <TextBlock Text="Solo lectura"/>
                    </Border>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ============ salida ============ -->
        <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="Salida" Margin="0,10,0,0">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="..." Width="32" Margin="6,0,0,0"
                            Click="Archivo_Click"/>
                    <TextBox x:Name="txArchivo"/>
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                    <CheckBox x:Name="chConsolidada" IsChecked="True" Margin="0,0,20,0"
                              Content="Agregar hoja consolidada con todo apilado"/>
                    <CheckBox x:Name="chOcultas" Margin="0,0,20,0"
                              Content="Incluir tambien las columnas ocultas de la tabla"/>
                    <CheckBox x:Name="chCalculadas" IsChecked="True"
                              Content="Completar columnas de formula leyendo la tabla"
                              ToolTip="Revit no expone la formula por API. El valor sale de la celda que dibuja la tabla, o sea con su redondeo."/>
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap"
                           Text="Cada hoja arranca con Modelo, GUID y Element ID. Los valores salen del modelo con precision completa, en la unidad que define la tabla."/>
            </StackPanel>
        </GroupBox>

        <!-- ============ barra inferior ============ -->
        <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0" x:Name="barra" Height="6" Minimum="0" Maximum="1" Value="0"
                         Visibility="Collapsed" Margin="0,0,0,6"/>

            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Left" x:Name="lbResumen" VerticalAlignment="Center"
                           Foreground="#444"/>
                <Button DockPanel.Dock="Right" x:Name="btExportar" Content="Exportar"
                        Style="{StaticResource Boton}" FontWeight="SemiBold" MinWidth="120"
                        Click="Exportar_Click"/>
                <Button DockPanel.Dock="Right" x:Name="btCerrar" Content="Cerrar"
                        Style="{StaticResource Boton}" Click="Cerrar_Click"/>
                <TextBlock/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
