<Window x:Class="Riga.Sectores.Ui.VentanaCoordenadas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leer coordenadas de sectores" Height="700" Width="1080"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" Background="#F0F0F0">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold" Foreground="#333"
                   Text="Elegi los suelos que definen los sectores"/>

        <GroupBox Grid.Row="1" Header="De donde sale cada valor" Background="White" Padding="8"
                  Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Sector" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="cbSector" Margin="6,0,20,0"
                          SelectionChanged="Fuente_Cambio"/>
                <Label Grid.Column="2" Content="Nivel del elemento" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="3" x:Name="cbNivel" Margin="6,0,0,0"
                          SelectionChanged="Fuente_Cambio"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <CheckBox DockPanel.Dock="Left" x:Name="chTodos" Margin="2,0,10,0"
                          Click="Todos_Click" VerticalAlignment="Center"
                          ToolTip="Marcar o desmarcar todo lo que se ve."/>
                <Label DockPanel.Dock="Left" Content="Buscar" VerticalAlignment="Center"/>
                <TextBox x:Name="txBuscar" TextChanged="Buscar_Cambio" Padding="3,2"
                         ToolTip="Filtra por id, tipo, nivel o por los valores que se van a exportar."/>
            </DockPanel>

            <DataGrid Grid.Row="1" x:Name="grilla" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                      GridLinesVisibility="All" VerticalGridLinesBrush="#E0E0E0"
                      HorizontalGridLinesBrush="#E0E0E0" Background="White"
                      AlternatingRowBackground="#FAFAFA" RowHeight="24">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="34" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="1.4*"/>
                    <DataGridTextColumn Header="Nivel del suelo" Binding="{Binding Nivel}" Width="130"/>
                    <DataGridTextColumn Header="Sector que se exporta" Binding="{Binding ValorSector}" Width="1*"/>
                    <DataGridTextColumn Header="Nivel que se exporta" Binding="{Binding ValorNivel}" Width="1*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" x:Name="lbResumen" VerticalAlignment="Center" Foreground="#444"/>
            <Button DockPanel.Dock="Right" Content="Cerrar" MinWidth="90" Padding="12,5"
                    Margin="6,0,0,0" Click="Cerrar_Click"/>
            <Button DockPanel.Dock="Right" x:Name="btGuardar" Content="Guardar JSON..." MinWidth="140"
                    Padding="12,5" Margin="6,0,0,0" FontWeight="SemiBold" Click="Guardar_Click"/>
            <TextBlock/>
        </DockPanel>
    </Grid>
</Window>
