<Window x:Class="Riga.LimpiarNulos.Ui.Ventana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpiar Parámetros Nulos" Height="600" Width="550"
        Icon="pack://application:,,,/LimpiarNulos;component/Resources/icon.jpg"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button" x:Key="BotonEjecutarStyle">
            <Setter Property="Background" Value="#FF005FB8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF707070"/>
                    <Setter Property="Background" Value="#FFE0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Margin" Value="0,1" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Fila_Click" />
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Titulos -->
            <RowDefinition Height="Auto"/> <!-- Buscador -->
            <RowDefinition Height="*"/>    <!-- LISTA (expande) -->
            <RowDefinition Height="Auto"/> <!-- Todos/Contador -->
            <RowDefinition Height="Auto"/> <!-- Progreso -->
            <RowDefinition Height="Auto"/> <!-- Botones -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Se ha guardado localmente el archivo previamente por seguridad."
                       Foreground="#FF2E7D32" FontWeight="SemiBold" Margin="0,0,0,5" x:Name="txtGuardadoInfo"/>
            <TextBlock Text="Esta herramienta convierte los parámetros que estén vacíos (null) a 'No'."
                       TextWrapping="Wrap" Foreground="#FF555555" FontSize="11" Margin="0,0,0,10"/>
            <TextBlock Text="Selecciona los parámetros booleanos (Sí/No) que quieres limpiar:"
                       TextWrapping="Wrap" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Column="0"/>
            <TextBox x:Name="txtBuscar" Grid.Column="1" TextChanged="txtBuscar_TextChanged" VerticalContentAlignment="Center" Padding="4,4,24,4"/>
            <Button x:Name="btnBorrarBusqueda" Content="✕" Grid.Column="1" HorizontalAlignment="Right" Width="20" Height="20" Margin="0,0,4,0"
                    Background="Transparent" BorderBrush="Transparent" Foreground="Gray" Click="BorrarBusqueda_Click" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="0" Margin="0,0,0,10">
            <Grid>
                <ListBox x:Name="listaParametros" SelectionMode="Single" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>

                                <TextBlock Grid.Column="1" Text="{Binding Nombre}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="5,0"/>

                                <TextBlock Grid.Column="2" Text="{Binding PorcentajeNullsTexto}" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,5,0" FontStyle="Italic"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="txtSinResultados" Text="No se encontraron parámetros booleanos."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnToggleTodos" Content="Seleccionar todos" Padding="10,5" Height="30" Click="ToggleTodos_Click" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <TextBlock x:Name="txtContador" Text="0 Parámetros seleccionados" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1" FontWeight="SemiBold"/>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <ProgressBar x:Name="barraProgreso" Height="10" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
            <TextBlock x:Name="txtEstadoProceso" Text="Iniciando..." Foreground="#FF005FB8" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="5">
            <Button x:Name="btnCancelar" Content="Cerrar" Width="90" Padding="0,6" Margin="0,0,10,0" Click="Cancelar_Click" Background="#FFF0F0F0" BorderBrush="#FFCCCCCC"/>
            <Button x:Name="btnEjecutar" Content="Limpiar 0 parámetros" Width="160" Padding="0,6" Click="Ejecutar_Click"
                    Style="{StaticResource BotonEjecutarStyle}"/>
        </StackPanel>
    </Grid>
</Window>
