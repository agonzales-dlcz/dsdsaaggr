<Window x:Class="Riga.LimpiarNulos.Ui.Ventana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpiar Parámetros Nulos" Height="550"
        SizeToContent="Width" MinWidth="450" MaxWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="Margin" Value="0,1" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Fila_Click" />
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Selecciona los parámetros booleanos (Sí/No) que quieres limpiar (convertir valores nulos a 'No'):"
                   TextWrapping="Wrap" Margin="0,0,0,15" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Column="0"/>
            <TextBox x:Name="txtBuscar" Grid.Column="1" TextChanged="txtBuscar_TextChanged" VerticalContentAlignment="Center" Padding="4"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <ListView x:Name="listaParametros" SelectionMode="Single" BorderThickness="1" BorderBrush="#FFCCCCCC">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="35">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Parámetro" DisplayMemberBinding="{Binding Nombre}" Width="Auto" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="txtSinResultados" Text="No se encontraron parámetros booleanos."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="Gray" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnToggleTodos" Content="Seleccionar todos" Padding="10,5" Click="ToggleTodos_Click" Grid.Column="0"/>
            <TextBlock x:Name="txtContador" Text="0 Parámetros seleccionados" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="2" FontWeight="SemiBold"/>
        </Grid>

        <!-- Nueva sección de descripción y progreso -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock x:Name="txtProgresoInfo" Text="Esta herramienta convierte los parámetros que estén vacíos (null) a 'No'.&#10;Se guardará automáticamente en local antes de iniciar."
                       TextWrapping="Wrap" Foreground="#FF555555" FontSize="11" Margin="0,0,0,8"/>
            <ProgressBar x:Name="barraProgreso" Height="10" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
            <TextBlock x:Name="txtEstadoProceso" Text="Iniciando..." Foreground="#FF005FB8" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Botones principales -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="5">
            <Button x:Name="btnCancelar" Content="Cancelar" Width="90" Padding="0,6" Margin="0,0,10,0" Click="Cancelar_Click" Background="#FFF0F0F0" BorderBrush="#FFCCCCCC"/>
            <Button x:Name="btnEjecutar" Content="Limpiar 0 parámetros" Width="160" Padding="0,6" Click="Ejecutar_Click"
                    Background="#FF005FB8" Foreground="White" BorderBrush="Transparent" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
