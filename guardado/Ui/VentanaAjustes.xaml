<Window x:Class="Riga.Guardado.Ui.VentanaAjustes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autoguardado"
        Height="660" Width="640" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Background="#F4F5F7">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#D9DEE4"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="Pie" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7B8794"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Guardado y sincronizacion automaticos"
                   FontSize="19" FontWeight="SemiBold" Foreground="#1F2933"/>

        <CheckBox Grid.Row="1" x:Name="chkActivo" Margin="0,12,0,12"
                  FontWeight="SemiBold" Content="Activar el autoguardado"
                  Checked="Activo_Cambio" Unchecked="Activo_Cambio"/>

        <GroupBox Grid.Row="2" Header="Guardado local">
            <StackPanel x:Name="panelLocal">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="chkLocal" Content="Guardar localmente cada"
                              VerticalAlignment="Center" Margin="0"
                              Checked="Que_Cambio" Unchecked="Que_Cambio"/>
                    <TextBox x:Name="txtMinLocal" Width="58" Margin="8,0,8,0" Padding="4,3"
                             TextAlignment="Center"/>
                    <TextBlock Text="minutos" VerticalAlignment="Center"/>
                    <TextBlock Text="(entre 1 y 480)" VerticalAlignment="Center"
                               Margin="10,0,0,0" Style="{StaticResource Pie}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Pie}" Margin="24,6,0,0"
                           Text="Es barato y no toca la central: se puede poner seguido."/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Sincronizacion con la central">
            <StackPanel x:Name="panelSyncTodo">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="chkSync" Content="Sincronizar cada"
                              VerticalAlignment="Center" Margin="0"
                              Checked="Que_Cambio" Unchecked="Que_Cambio"/>
                    <TextBox x:Name="txtMinSync" Width="58" Margin="8,0,8,0" Padding="4,3"
                             TextAlignment="Center"/>
                    <TextBlock Text="minutos" VerticalAlignment="Center"/>
                    <TextBlock Text="(entre 1 y 480)" VerticalAlignment="Center"
                               Margin="10,0,0,0" Style="{StaticResource Pie}"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Pie}" Margin="24,6,0,0"
                           Text="Guarda la local primero, espera a que termine, y recien ahi sincroniza. Cuando sincroniza, el reloj del guardado local vuelve a cero: no tiene sentido guardar de nuevo dos minutos despues."/>

                <StackPanel x:Name="panelSync" Margin="24,8,0,0">
                    <CheckBox x:Name="chkLiberar"
                              Content="Liberar los elementos prestados al sincronizar"/>
                    <TextBlock Style="{StaticResource Pie}" Margin="24,0,0,6"
                               Text="Si lo dejas sin marcar seguis siendo dueno de lo que estabas editando."/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Comentario:" VerticalAlignment="Center" Width="82"/>
                        <TextBox x:Name="txtComentario" Width="400" Padding="4,3"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Para las dos">
            <StackPanel x:Name="panelComun">
                <CheckBox x:Name="chkSoloCambios"
                          Content="Saltar la vuelta si el modelo no tiene cambios"/>
                <TextBlock Style="{StaticResource Pie}" Margin="24,8,0,0"
                           Text="Corre en silencio: no abre ventanas ni interrumpe nada. Lo que hace queda anotado en la bitacora de aca abajo."/>
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="5" Background="#EEF2F6" BorderBrush="#D9DEE4" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="lbProxLocal" FontWeight="SemiBold" Foreground="#1F2933"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="lbProxSync" FontWeight="SemiBold" Foreground="#1F2933"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock x:Name="lbUltima" Margin="0,6,0,0" Foreground="#52606D"
                           TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="90" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="lbLog" FontFamily="Consolas" FontSize="11"
                               Foreground="#323F4B" TextWrapping="NoWrap"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="6">
            <Button DockPanel.Dock="Right" x:Name="btCancelar" Content="Cancelar" MinWidth="100"
                    Padding="14,7" Margin="8,0,0,0" IsCancel="True" Click="Cancelar_Click"/>
            <Button DockPanel.Dock="Right" x:Name="btGuardar" Content="Guardar" MinWidth="120"
                    Padding="14,7" Margin="8,0,0,0" FontWeight="SemiBold"
                    IsDefault="True" Click="Guardar_Click"/>
            <Button DockPanel.Dock="Left" x:Name="btSyncYa" Content="Sincronizar ahora"
                    MinWidth="140" Padding="14,7" Margin="8,0,0,0" Click="SyncYa_Click"/>
            <Button DockPanel.Dock="Left" x:Name="btLocalYa" Content="Guardar ahora"
                    MinWidth="120" Padding="14,7" Click="LocalYa_Click"/>
            <TextBlock/>
        </DockPanel>
    </Grid>
</Window>
