<Window x:Class="Riga.ConcatenadorParametros.UI.ConcatenadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Concatenador de Parámetros" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Selección de origen -->
        <GroupBox Header="Origen de Elementos" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <RadioButton Content="Seleccionar elementos en modelo"
                             IsChecked="{Binding UsarSeleccion}" Margin="0,0,0,5"/>
                <Button Content="Seleccionar en modelo"
                        Command="{Binding SeleccionarCommand}"
                        IsEnabled="{Binding UsarSeleccion}"
                        Margin="20,0,0,10" Padding="5,2"/>

                <RadioButton Content="Filtrar por categoría"
                             IsChecked="{Binding UsarCategoria}" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Categorias}"
                          SelectedItem="{Binding CategoriaSeleccionada}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding UsarCategoria}"
                          Margin="20,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Parámetros de Origen -->
        <GroupBox Header="Parámetros de Origen a Concatenar" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <ItemsControl ItemsSource="{Binding ParametrosOrigenSeleccionados}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding DataContext.ParametrosDisponibles, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          SelectedItem="{Binding Valor, Mode=TwoWay}"
                                          Grid.Column="0" Margin="0,0,5,0"/>
                                <Button Content=" X " Command="{Binding DataContext.QuitarParametroCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Grid.Column="1"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content=" + Añadir Parámetro " Command="{Binding AñadirParametroCommand}"
                        HorizontalAlignment="Left" Padding="10,2" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Configuración -->
        <GroupBox Header="Configuración" Grid.Row="3" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Separador:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"/>
                <TextBox Text="{Binding Separador}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Text="Parámetro Destino:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding ParametrosDestinoDisponibles}"
                          SelectedItem="{Binding ParametroDestino}"
                          Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </GroupBox>

        <Button Content="Ejecutar" Command="{Binding EjecutarCommand}" Grid.Row="4"
                Padding="10,5" HorizontalAlignment="Right" Width="100"/>
    </Grid>
</Window>
